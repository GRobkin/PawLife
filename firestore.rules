rules_version = '2';

// Ningún cliente accede ya a Firestore directamente.
//
// La app Flutter habla con la API PHP (../apipaw) y es esa API la que lee y
// escribe aquí, autenticada con una service account. Las service accounts
// tienen acceso de administrador y NO pasan por estas reglas, así que
// denegarlo todo no rompe el backend: solo cierra la puerta trasera.
//
// Es importante que quede cerrada. La configuración de Firebase viaja dentro
// del APK, así que cualquiera puede extraerla, autenticarse contra el proyecto
// y hablar con Firestore por su cuenta. Si estas reglas siguieran permitiendo
// escribir a quien tenga sesión, la validación del backend sería opcional.
//
// El aislamiento entre usuarios pasa a estar en la API: verifica el ID token
// de Firebase y construye todas las rutas como users/{uid}/... con el uid que
// sale de ese token.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
